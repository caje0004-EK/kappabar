
---
import Date from "../assets/svg/Date.svg";
import Decoration from "../assets/svg/5-element.svg";


const { title, label, image, dateImage } = Astro.props;
---


<article class="event-card">
  <img class="event-image" src={image} alt={title} />
  <span class="event-label">{label}</span>
  <div class="event-date">
  <img src={dateImage} alt="Eventdato" />
</div>
  <div class="event-content">
    <h1>{title}</h1>
    <img
      class="decoration"
      src={Decoration.src}
      alt=""
    />
  </div>
</article>

<style>
.event-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  aspect-ratio: 500 / 284;
  overflow: hidden;
  border: var(--border-4) solid var(--color-violet-500);
  border-radius: var(--radius-xl);
  background: var(--color-base-black);
}

 .event-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  z-index: 1;
}

  .event-label {
    position: absolute;
    top: 4%;
    left: 6%;
    z-index: 4;
    padding: 8px 20px;
    background: var(--color-violet-500);
    color: white;
    border-radius: var(--radius-full);
    font-size: var(--label-large-size);
    font-size: 18px;
  }

  .event-date {
    position: absolute;
    top: -1%;
    right: 5%;
    width: 15%;
    z-index: 5;
  }

  .event-date img {
    width: 100%;
    height: auto;
  }

  .date-text {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 18px;
  color: white;
  line-height: 1;
  font-family: var(--font-family-regular);
}

  .date-text span:first-child {
    font-size: clamp(22px, 4.5vw, 36px);
  }

  .date-text span:last-child {
    font-size: clamp(15px, 3vw, 23px);
  }

  .event-content {
  position: absolute;
  bottom: -2px;
  left: -2px;
  width: calc(100% + 4px);
  min-height: 28%;
  padding: var(--space-16);
  background: var(--color-gradient-violet300);
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
  isolation: isolate;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
   opacity: 0.9;
}
  .event-content h1 {
    position: relative;
    z-index: 2;
    color: white;
    font-family: var(--font-family-headline);
    font-size: clamp(20px, 5vw, 20px);
    line-height: 1;
    max-width: 80%;
  }

  .decoration {
    position: absolute;
    width: 38%;
    height: auto;
    right: -10%;
    bottom: -90%;
    z-index: 1;
    pointer-events: none;
  }

  @media (min-width: 760px) {
    .event-content {
      min-height: 20%;
      padding: var(--space-24);
    }
    .event-content h1 {
    font-size: clamp(20px, 5vw, 20px);
  }

  .event-date {
    position: absolute;
    top: -1%;
    right: 5%;
    width: 10%;
    z-index: 5;
  }

    .decoration {
    position: absolute;
    width: 35%;
    height: auto;
    right: -10%;
    bottom: -100%;
    z-index: 1;
    pointer-events: none;
  } }

  @media (min-width: 1024px) {

    .date-text {
        padding-top: 32px;
    }
  .event-date {
    position: absolute;
    top: -1%;
    right: 5%;
    width: 12%;
    z-index: 5;
  }
    .event-content {
      min-height: 10%;
      padding: var(--space-32);
    }

      .event-content h1 {
    font-size: clamp(25px, 5vw, 12px);
  }

   .decoration {
    position: absolute;
    width: 40%;
    height: auto;
    right: -12%;
    bottom: -70%;
    z-index: 1;
    pointer-events: none;
  }

  .event-label {
    position: absolute;
    top: 4%;
    left: 6%;
    z-index: 4;
    padding: 8px 20px;
    background: var(--color-violet-500);
    color: white;
    border-radius: var(--radius-full);
    font-size: var(--label-large-size);
    font-size: 15px;
  }

  }
</style>
