---
import NewsletterForm from "./NewsletterForm.astro";
import logo from "../assets/svg/logo.svg";
---

<footer class="footer">
  <div class="container">
    
    
    <div class="col-brand">
      <div class="logo-wrap">
        <img src={logo.src} alt="KAPPA BAR" class="logo" />
        <p class="tagline">WHERE PIXELS MEET COCKTAILS</p>
      </div>

      <div class="newsletter">
        <h3>TILMELD NYHEDSBREV</h3>
        <p>
          Tilmeld dig KAPPA BARs nyhedsbrev, og få de seneste nyheder direkte i din indbakke. Vi holder dig opdateret om kommende events, gode tilbud, nye spiloplevelser og alt det, der sker hos KAPPA BAR.
        </p>

        <NewsletterForm idPrefix="footer-newsletter" />
      </div>
    </div>

    
    <div class="col-info">
      <div class="block">
        <h3>ÅBNINGSTIDER</h3>
        <ul>
          <li>Mandag: Lukket</li>
          <li>Tirsdag: 16–22</li>
          <li>Onsdag: 16–23</li>
          <li>Torsdag: 16–24</li>
          <li>Fredag: 16–24</li>
          <li>Lørdag: 14–24</li>
          <li>Søndag: 12–22</li>
        </ul>
      </div>

      <div class="block">
        <h3>KONTAKT</h3>
        <p>
          Tlf.: <a href="tel:+4553731337">+4553731337</a><br />
          E-mail: <a href="mailto:info@kappabar.dk">info@kappabar.dk</a>
        </p>
        <p class="address">
          Rådhusstræde 4A,<br />
          1466 København
        </p>

        <div class="socials">
          <a href="#" aria-label="Instagram" class="social-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href="#" aria-label="Facebook" class="social-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z" />
            </svg>
          </a>
          <a href="#" aria-label="TikTok" class="social-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16.6 5.82s.51.5 0 0A4.278 4.278 0 0 1 15.54 3h-3.09v12.4a2.592 2.592 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    
    <div class="col-nav">
      <h3>NAVIGATION</h3>
      <ul>
        <li><a href="/aktiviteter">Aktiviteter</a></li>
        <li><a href="/events">Events</a></li>
        <li><a href="/gruppearrangementer">Gruppearrangementer</a></li>
        <li><a href="/om-os">Om os</a></li>
        <li><a href="/book-bord">Book bord</a></li>
        <li><a href="/menu">Se menu</a></li>
        <li><a href="/kontakt">Kontakt</a></li>
        <li><a href="/job">Job</a></li>
      </ul>
    </div>

  </div>

  <p class="copyright">© KAPPA BAR 2026</p>
</footer>

<style>
  .footer {
    background: var(--color-base-black);
    color: var(--color-base-white);
    padding: 56px 24px 24px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 14px;
    letter-spacing: 0.03em;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

 
  .col-brand {
    max-width: 380px;
    width: 100%;
    margin: 0 auto;
  }

  .logo {
    width: 240px;
    display: block;
    margin-bottom: 10px;
  }

  .tagline {
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 40px;
  }

  .newsletter p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-base-white);
    margin: 0 0 18px;
  }

  
  .col-info,
  .col-nav {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .col-info p {
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 20px;
  }

  .social-box {
    width: 48px;
    height: 48px;
    background: var(--color-base-white);
    color: var(--color-violet-500);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }

  .social-box:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }

  .copyright {
    text-align: center;
    font-size: 11px;
    color: var(--color-grey-500);
    margin: 56px 0 0;
  }

  
  @media (min-width: 960px) {
    .footer {
      padding: 72px 48px 28px;
    }

    .container {
      display: grid;
      grid-template-columns: 1.4fr 1fr 0.8fr;
      align-items: start;
      gap: 64px;
    }

    .col-brand {
      margin: 0;
    }

    .col-info,
    .col-nav {
      text-align: left;
    }

    .socials {
      justify-content: flex-start;
    }
  }
</style>

{/*
  SÅDAN BRUGER DU FOOTER-KOMPONENTEN:
     og opdater src="" på <img> i toppen af filen.
  2. Importer og indsæt den i jeres Layout.astro (så den vises på alle sider):
     import Footer from '../components/Footer.astro';
     ...
     <Footer />
*/}