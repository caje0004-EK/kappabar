</section>

<style>
  .newsletter {
    min-height: 100vh;
    padding: clamp(3rem, 8vw, 7.5rem) var(--space-24);
    margin-bottom: var(--space-40);
    /* overflow: hidden; */
    background: var(--color-base-black);
    color: var(--color-base-white);
  }

  .newsletter__inner {
    width: min(100%, 1100px);
    margin-inline: auto;
  }

  .newsletter__header {
    margin-bottom: clamp(3rem, 7vw, 7rem);
    text-align: center;
  }

  .newsletter__header p {
    margin: 0;
    font-family: var(--font-family-regular);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.1;
  }

  .newsletter__header h1 {
    margin: 0;
    font-family: var(--font-family-headline);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
  }

  .newsletter__content {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .newsletter__signup h2 {
    margin-bottom: 0.5rem;
    font-family: var(--font-family-headline);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.08;
  }

  .newsletter__description {
    max-width: 34rem;
    margin-bottom: 1.5rem;
    font-size: clamp(0.9rem, 1.3vw, 1.125rem);
    line-height: 1.45;
  }

  .newsletter__socials a:focus-visible {
    outline: 3px solid var(--color-violet-200);
    outline-offset: 4px;
  }

  .newsletter__socials {
    position: relative;
    min-height: 31rem;
  }

  .social-card {
    position: absolute;
    display: flex;
    /* width: clamp(9.5rem, 18vw, 13rem);
    aspect-ratio: 1 / 1.08;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: var(--radius-xl);
    background: var(--color-gradient-violet);
    color: var(--color-base-white); */
    transition: transform 200ms ease;
  }

  .social-card:hover {
    transform: translateY(-0.4rem) rotate(0);
  }

  .social-card svg {
    /* width: 62%;
    height: auto; */
  }

  .social-card > span {
    align-self: stretch;
    font-family: var(--font-family-regular);
    font-size: clamp(0.75rem, 1.25vw, 1rem);
    text-align: center;
    white-space: nowrap;
  }

  .ig {
    transform: rotate(-5deg);
    right: 80;
    top: -20;
    z-index: 2;
  }

  .fb {
    transform: rotate(8deg);
    right: -15;
    top: 190;
    z-index: 1;
  }

  .tt {
    transform: rotate(-10deg);
    top: 370;
    right: 150;
  }

  @media (max-width: 1023px) {
    .newsletter {
      padding-inline: clamp(1.5rem, 4vw, 3rem);
    }

    .newsletter__content {
      grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
      gap: 2rem;
    }

    .newsletter__socials {
      min-height: 34rem;
    }

    .social-card {
      width: clamp(10rem, 27vw, 15rem);
    }

    .ig {
      transform: rotate(-5deg);
      right: 70;
      z-index: 2;
    }

    .fb {
      transform: rotate(8deg);
      right: -15;
      top: 190;
      z-index: 1;
    }

    .tt {
      transform: rotate(-10deg);
      top: 370;
    }
  }

  @media (max-width: 700px) {
    .newsletter {
      min-height: 100vh;
      padding: 3rem clamp(1.25rem, 8.5vw, 2.75rem) 4rem;
    }

    .newsletter__header {
      margin-bottom: 3rem;
    }

    .newsletter__header p {
      font-size: clamp(1.65rem, 6vw, 2rem);
    }

    .newsletter__header h1 {
      font-size: clamp(2.5rem, 9vw, 3.25rem);
    }

    .newsletter__content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .newsletter__signup h2 {
      font-size: clamp(1.8rem, 7vw, 2.2rem);
    }

    .newsletter__description {
      font-size: 1rem;
    }

    .newsletter__socials {
      /* display: grid; */
      min-height: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      padding-top: 0.5rem;
    }

    .social-card {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      /* width: 100%; */
      /* max-width: 13rem; */
      justify-self: center;
      /* aspect-ratio: 1 / 1.08; */
    }

    .ig {
      transform: rotate(-5deg);
      right: 0;
      z-index: 2;
    }

    .fb {
      transform: rotate(8deg);
      right: -80;
      top: -20;
      z-index: 1;
    }

    .tt {
      transform: rotate(-10deg);
      top: -40;
    }

    .social-card > span {
      font-size: clamp(0.7rem, 3vw, 0.9rem);
    }
  }
</style>
