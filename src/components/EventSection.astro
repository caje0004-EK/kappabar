---
import EventCardStack from "./EventCardStack.astro";
import EventsBackground from "../assets/svg/pixelBg.svg?raw";
import Button from "../components/buttons.astro";
---

<div class="events-container">
  <div class="events-background" aria-hidden="true" set:html={EventsBackground} />

  <div class="events-text">
    <h2>EVENTS</h2>
    <p>Hos Kappa Bar gør vi os umage med at holde stemningen i top med et unikt udvalg af sjove koncepter og udfordringer.</p>
    <p>Hver uge stabler vi særlige events på benene, hvor du kan deltage i klassiske pubquizzes og brætspilsaftener – eller step up med vores e-sportsturneringer og temaaftener, som er perfekte til at dyste med dine venner.</p>
  </div>

  <div class="events-cards">
    <EventCardStack />
  </div>

  <Button variant="tertiary" href="/om-os">
    Se events
  </Button>
</div>

<style>
  /* =========================
     MOBILE FIRST
  ========================= */

  .events-container {
    position: relative;
    isolation: isolate;
    width: 100%;
    margin: 0 auto;
    padding: 50px 5%;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "text"
      "button"
      "cards";
    gap: 20px;
  }

  .events-background {
    display: none;
  }

  /* TEKST */

  .events-text {
    grid-area: text;
    text-align: left;
  }

  .events-text h2 {
    color: white;
    font-size: clamp(48px, 8vw, 64px);
    text-align: center;
    margin-bottom: 25px;
  }

  .events-text p {
    color: white;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  /* EVENTKORT */

  .events-cards {
    grid-area: cards;
    width: 100%;
    min-width: 0;
  }

  /* KNAP */

  :global(.btn.tertiary) {
    grid-area: button;
    justify-self: start;
    align-self: start;
    display: inline-block;
    margin-top: 0;
  }

  /*TABLET*/

  @media (min-width: 760px) {
    .events-container {
      max-width: 750px;
      padding: 70px 5%;
      gap: 20px;
    }

    .events-text {
      text-align: center;
    }

    .events-text h2 {
      font-size: 60px;
    }

    .events-text p {
      text-align: left;
    }

    .events-cards {
      width: 85%;
      margin: 0 auto;
    }
  }

  /*DESKTOP*/

  @media (min-width: 1024px) {
    .events-container {
      position: relative;
      isolation: isolate;
      width: 70%;
      max-width: 1400px;
      min-height: 650px;
      margin: 0 auto;
      padding: 80px 0;
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      grid-template-areas:
        "text cards"
        "button cards";
      column-gap: 50px;
      row-gap: 5px;
      align-items: center;
    }

    /* BAGGRUND */

    .events-background {
      display: block;
      position: absolute;
      z-index: -1;
      width: 100vw;
      height: calc(100% + 100px);
      left: 50%;
      top: -61px;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .events-background :global(svg) {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible; /* så pixels ikke klippes, mens de falder ind */
    }

    .events-background :global(rect.px) {
      will-change: transform, opacity;
    }

    /* TEKST */

    .events-text {
      grid-area: text;
      text-align: left;
      align-self: end;
    }

    .events-text h2 {
      text-align: left;
      font-size: clamp(50px, 4vw, 76px);
      margin-bottom: 20px;
      padding-top: 20px;
    }

    .events-text p {
      text-align: left;
      line-height: 1.5;
      margin-bottom: 10px;
    }

    /* EVENTKORT */

    .events-cards {
      grid-area: cards;
      width: 100%;
      max-width: 800px;
      min-width: 0;
    }

    /* KNAP */

    :global(.btn.tertiary) {
      grid-area: button;
      justify-self: start;
      align-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events-background :global(rect.px) {
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  const container = document.querySelector<HTMLElement>(".events-container");

  if (container) {
    const svg = container.querySelector<SVGSVGElement>(".events-background svg");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    type Pixel = { el: SVGRectElement; start: number; dy: number };
    const pixels: Pixel[] = [];

    // 1) Find alle små pixels og giv dem hver deres tilfældige værdier
    svg?.querySelectorAll<SVGRectElement>("rect").forEach((rect) => {
      if (rect.width.baseVal.value > 100) return; // spring den store flade over

      const x = rect.x.baseVal.value;
      const y = rect.y.baseVal.value;
      const fromBottom = y > 700; // pixels i bunden stiger op, top-pixels falder ned

      pixels.push({
        el: rect,
        start: (x / 1512) * 0.35 + Math.random() * 0.25, // bølge fra venstre mod højre
        dy: (fromBottom ? 1 : -1) * (150 + Math.random() * 450),
      });
      rect.classList.add("px");
    });

    const ease = (t: number) => 1 - Math.pow(1 - t, 3); // easeOutCubic
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    // 2) Beregn fremdrift ud fra scroll og flyt hver pixel
    function update() {
      if (reduceMotion) return;

      const rect = container!.getBoundingClientRect();
      const vh = window.innerHeight;
      const progress = clamp((vh - rect.top) / (vh * 0.8)); // 0 → 1

      for (const p of pixels) {
        const t = clamp((progress - p.start) / 0.4);
        const e = ease(t);
        p.el.style.opacity = String(clamp(t * 3));
        p.el.style.transform = `translateY(${p.dy * (1 - e)}px)`;
      }
    }

    // 3) Kør kun én gang pr. billede, så det er jævnt
    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }
</script>
