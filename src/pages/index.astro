---
import "../styles/custom.css";
import "../styles/struktur.css";
import "../styles/general.css";
import PageLayout from "../layouts/PageLayout.astro";
import BigCard from "../components/BigCard.astro";
import Cheers from "../assets/img/cheers.webp";
import TableTopview from "../assets/img/table-topview.webp";
import HeroUnit from "../components/HeroUnit.astro";
import EventSection from "../components/EventSection.astro";
import AppSection from "../components/AppSection.astro";
import NyhedsbrevSection from "../components/nyhedsbrev-section.astro";
import Footer from "../components/footer.astro";
---

<PageLayout heading="KAPPA BAR DANMARK | Social Gaming Bar ">
  <HeroUnit />
  <div class="reveal">
    <BigCard
      img={TableTopview}
      imgText="Bord med kontroller set oppefra"
      emne="MERE END BARE EN BAR"
      titel="DIN GAMING BAR"
      text="Velkommen til KAPPA BAR, baren for social gaming. Hos os kan du kombinere god mad og lækre cocktails med gaming i alle afskygninger. Vi tilbyder alt fra konsolspil til brætspil, så der er noget for enhver smag. Hos KAPPA BAR lægger vi rammerne for en hyggelig aften fyldt med god stemning, grin og lidt venskabelig konkurrence."
      buttonText="Se aktiviteter"
      buttonText2="Om konceptet"
    />
  </div>
  <div class="reveal">
    <EventSection />
  </div>
  <div class="reveal">
    <BigCard
      img={Cheers}
      imgText="Selskab, der skåler med vin"
      emne="GRUPPEARRANGEMENTER"
      titel="MERE END 10?"
      text="Hvad enten I planlægger firmafest, fødselsdag, polterabend eller bare den ultimative gamingaften for hele venneflokken, skaber Kappa Bar de perfekte rammer. Vi kombinerer det bedste fra e-sport, gaming, mad og kolde drikkevarer, så I kan fokusere 100% på hyggen, fællesskabet og konkurrencen."
      buttonText="Læs mere"
    />
  </div>
  <div class="reveal">
    <AppSection />
  </div>
  <div class="reveal">
    <NyhedsbrevSection />
  </div>
  <Footer />
</PageLayout>

<style is:global>
  .reveal.will-reveal {
    opacity: 0;
    transform: translateY(48px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.will-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal.will-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = document.querySelectorAll<HTMLElement>(".reveal");

  if (!reduceMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target); // animér kun én gang
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );

    items.forEach((el) => {
      el.classList.add("will-reveal");
      observer.observe(el);
    });
  }
</script>
